{
  "name": "codename",
  "version": "1.0.0",
  "private": true,
  "description": "Angular frontend and AdonisJS REST API",
  "workspaces": [
    "app",
    "server"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
